# Application
APP_NAME=FHIR Case Management System
DEBUG=true

# PostgreSQL (audit logs)
DATABASE_URL=postgresql+asyncpg://cms:cms@postgres:5432/cms_audit

# Neo4j (clinical knowledge graph)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# FHIR server (HAPI)
FHIR_BASE_URL=http://hapi-fhir:8080/fhir

# Local inference via Greyflow Ollama (recommended for local dev)
LLM_BASE_URL=http://greyflow-ai:11434/v1
LLM_MODEL=mistral-nemo:latest
LLM_API_KEY=ollama
GREYFLOW_AI_HOST_IP=100.124.13.39

# OpenAI (only needed if LLM_BASE_URL is not set)
# OPENAI_API_KEY=sk-your-key-here

# Phase 2 — FHIR observation webhooks
WEBHOOK_SECRET=change-me-in-production
WEBHOOK_CLINICAL_QUERY=Review the latest observation in context and recommend whether care management should proceed.
WEBHOOK_ENABLED=true
WEBHOOK_PUBLIC_BASE_URL=http://api:8000
