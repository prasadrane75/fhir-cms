# greyflow-app deployment — copy to .env on the app server
APP_NAME=FHIR Case Management System
DEBUG=false

# Remote Postgres on greyflow-db (rulescube-postgres)
GREYFLOW_DB_HOST_IP=100.96.75.123
DATABASE_URL=postgresql+asyncpg://cms:cms@greyflow-db:5432/cms_audit

# Neo4j + HAPI run on greyflow-app (same compose stack)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

FHIR_BASE_URL=http://hapi-fhir:8080/fhir

# Ollama on greyflow-ai (Tailscale)
GREYFLOW_AI_HOST_IP=100.124.13.39
LLM_BASE_URL=http://greyflow-ai:11434/v1
LLM_MODEL=mistral-nemo:latest
LLM_API_KEY=ollama

# Public URL for FHIR webhooks (use greyflow-app Tailscale IP or reverse proxy)
WEBHOOK_SECRET=change-me-in-production
WEBHOOK_CLINICAL_QUERY=Review the latest observation in context and recommend whether care management should proceed.
WEBHOOK_ENABLED=true
WEBHOOK_PUBLIC_BASE_URL=http://<greyflow-app-tailscale-ip>:8001

# Optional: pre-built image (skip local build on server)
# FHIR_CMS_IMAGE=ghcr.io/your-org/fhir-cms-api:latest
# FHIR_CMS_PORT=8001
